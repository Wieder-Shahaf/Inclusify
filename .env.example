# Inclusify Environment Variables
# Copy to .env and customize for your environment.
#
# Defaults below are for LOCAL DEV via docker-compose (service hostnames like
# `postgres`, `minio`). For a NATIVE setup (uvicorn/next on the host) swap the
# service hostnames for `localhost` where noted. Production (Stack A: Railway +
# Modal + R2) values live in docs/STACK-A-PROVISIONING.md, not here.

# ============================================
# Database
# ============================================
# Docker Compose: PGHOST=postgres | Native: PGHOST=localhost
PGHOST=postgres
PGPORT=5432
PGDATABASE=inclusify
PGUSER=postgres
PGPASSWORD=devpassword
# "require" for managed Postgres (Azure / Railway). Empty for local dev.
PGSSL=
# Optional: full SQLAlchemy URL. If unset it is built from the PG* vars above.
# DATABASE_URL=

# ============================================
# Authentication
# ============================================
# JWT signing secret. Required. Long random string in production.
JWT_SECRET=dev-secret-change-in-production
# Google OAuth (required for Google login). From Google Cloud Console.
# Prod: add the Railway frontend domain to the Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Frontend / CORS
# ============================================
# Backend's view of the frontend (OAuth redirects + CORS).
FRONTEND_URL=http://localhost:3000
# Frontend's view of the backend. NOTE: this is BUILD-TIME — Next.js inlines it
# at build, so on Railway it must be set as a build variable, not just runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS allowed origins (comma-separated). Falls back to localhost if empty.
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# vLLM inference (GPU layer)
# ============================================
# Local dev: tunnel to a vLLM server, or point at a deployed Modal endpoint.
#   Azure VM tunnel:  ssh -L 8001:localhost:8001 azureuser@<vm-public-ip>
#   Modal (prod):     https://<workspace>--inclusify-vllm-serve.modal.run
VLLM_URL=http://localhost:8001
# Bearer token matching the vLLM server's --api-key (empty = no auth header).
# Prod: the value of the Modal `inclusify-vllm-key` secret.
VLLM_API_KEY=
# Served model name — must match the LoRA module name in the vLLM app. Leave as-is.
VLLM_MODEL_NAME=inclusify
# Tuning. On Modal, a cold start (torch.compile + CUDA-graph capture, cache is
# lost on scale-to-zero) runs ~2-3 min — longer than a default 120s timeout. So
# the first request after idle gets a wider timeout and more breaker headroom.
VLLM_TIMEOUT=240.0
VLLM_MAX_CONCURRENT=16
VLLM_CIRCUIT_FAIL_MAX=5
VLLM_CIRCUIT_RESET_TIMEOUT=60

# ============================================
# Model health endpoint (Stack A §2.3)
# ============================================
# TRUE when the GPU is serverless and scales to zero (Modal): /api/v1/health/model
# never probes vLLM, so a health poll can't wake/keep the GPU warm. Keep FALSE for
# an always-on GPU (Azure VM); the probe is then cached for MODEL_HEALTH_CACHE_TTL.
MODEL_SCALE_TO_ZERO=false
MODEL_HEALTH_CACHE_TTL=300.0

# ============================================
# Object storage (S3-compatible: MinIO in dev, Cloudflare R2 in prod)
# ============================================
# Compose: http://minio:9000 | Native: http://localhost:9000 | Prod (R2):
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=texts
# "auto" for R2; ignored by MinIO.
S3_REGION=auto

# ============================================
# Redis (optional — auth degrades gracefully without it)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Email
# ============================================
# Password-reset + contact-form email via Resend. Empty key = email sends skipped.
RESEND_API_KEY=
# Sender for ALL Resend mail. In prod this MUST be an address on a Resend-VERIFIED
# domain, or Resend only delivers to the account owner. (Single var — no EMAIL_FROM.)
RESEND_FROM=Inclusify <onboarding@resend.dev>
# Contact form via SMTP (Gmail by default).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Comma-separated inboxes that receive contact-form messages.
# If empty, falls back to all users with role='site_admin'.
CONTACT_RECIPIENTS=inclusify.support@gmail.com

# ============================================
# Build (populated by CI/CD; leave empty for local dev)
# ============================================
# "development" for local dev, "runtime"/"production" for prod Docker builds.
BUILD_TARGET=development
BUILD_TIME=
GIT_COMMIT=
