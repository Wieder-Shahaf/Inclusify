# OS / IDE
.DS_Store
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.db
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets / local environment.
# Keep the specific historical names too: these files may still exist in a
# teammate's checkout, and un-ignoring them risks a stray `git add -A`.
.env
.env.team
env.team
az.txt
Azure_env_key.txt
*_key.txt
*.pem

# Node
node_modules/
dist/
build/
.next/
.out/

# Data / models — large artifacts that do not belong in git.
# NOTE: ml/adapters/*/adapter_model.safetensors IS tracked on purpose; it is the
# deployed LoRA and the project ships it. Do not add a blanket *.safetensors rule.
*.ckpt
*.pt
*.bin
ml/data/raw/
ml/data/private/
ml/logs/
ml/adapters/*/checkpoint-*/
ml/adapters/*/runs/
unsloth_compiled_cache/

# Claude Code / AI tooling — instructions for an assistant, not project files
.claude
.agents/
skills-lock.json
CLAUDE.md

# Course submission / instruction files (not part of the codebase)
Project Submmisions and Instractions Files/
